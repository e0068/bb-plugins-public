{
  "extends": "./packages/plugin-base/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@bb-plugins/*": [
        "./packages/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "@codemirror/*": [
        "./node_modules/@codemirror/*"
      ],
      "@radix-ui/react-tabs": [
        "./node_modules/@radix-ui/react-tabs"
      ]
    }
  },
  "include": [
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "hooks",
    "db",
    "filesync",
    "api",
    "cli",
    "shared",
    "views",
    "editor",
    "attachments",
    "delegate",
    "mentions",
    "lifecycle",
    "steer",
    "shell",
    "client",
    "remote",
    "folders",
    "test-support"
  ]
}
