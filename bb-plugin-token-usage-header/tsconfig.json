{
  "extends": "./packages/plugin-base/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@bb-plugins/*": [
        "./packages/*"
      ]
    },
    "skipLibCheck": false,
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "app.tsx",
    "components",
    "lib",
    "src"
  ]
}
