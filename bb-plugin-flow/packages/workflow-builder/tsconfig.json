{
  "extends": "../plugin-base/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.ts", "react/*.ts", "react/*.tsx"],
  "exclude": ["*.test.ts", "react/*.test.tsx"]
}
