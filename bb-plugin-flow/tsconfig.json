{
  "extends": "./packages/plugin-base/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "@get-bb/plugin-sdk": [
        "./node_modules/@get-bb/plugin-sdk"
      ],
      "@bb-plugins/*": [
        "./packages/*"
      ],
      "@codemirror/*": [
        "./node_modules/@codemirror/*"
      ],
      "@uiw/react-codemirror": [
        "./node_modules/@uiw/react-codemirror"
      ]
    },
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "app.tsx",
    "architecture.test.ts",
    "vitest.config.ts",
    "lib",
    "shared",
    "core",
    "components",
    "server",
    "app",
    "tools",
    "./packages/cellular-kit/index.ts",
    "./packages/cellular-kit/vendor/index.js",
    "./packages/cellular-kit/vendor/manifest.json"
  ]
}
