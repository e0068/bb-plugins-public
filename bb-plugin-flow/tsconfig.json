{
  "extends": "./packages/plugin-base/tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "@get-bb/plugin-sdk": [
        "./node_modules/@get-bb/plugin-sdk"
      ],
      "@bb-plugins/*": [
        "./packages/*"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "server.ts",
    "server.test.ts",
    "app.tsx",
    "architecture.test.ts",
    "vitest.config.ts",
    "lib",
    "shared",
    "core",
    "components",
    "server",
    "app",
    "tools"
  ]
}
